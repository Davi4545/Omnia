<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Caixa ONDIS</title>
<style>
:root{--bg:#f5f9ff;--panel:#fff;--panel2:#f8fbff;--line:#dce8f5;--text:#0d2038;--muted:#69809c;--brand:#1166d9;--brand2:#0b4fb3;--good:#0aaa6e;--warn:#f29b38;--bad:#e64b5f;--purple:#7c5ce6;--shadow:0 16px 42px rgba(29,68,116,.08)}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#f7fbff,#eef7ff);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}.app{min-height:100vh;display:grid;grid-template-columns:238px 1fr}.side{background:#fff;border-right:1px solid var(--line);padding:22px 16px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:10px;padding:4px 8px 18px}.brandMark{width:38px;height:38px;border-radius:12px;background:linear-gradient(145deg,#1680ff,#0b4fb3);display:grid;place-items:center;color:#fff;font-size:19px;box-shadow:0 10px 25px rgba(17,102,217,.24)}.brand b{font-size:17px;letter-spacing:.02em}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:2px}.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;color:#56708e;padding:11px 12px;border-radius:11px;display:flex;align-items:center;gap:10px;font-weight:750;text-align:left;cursor:pointer}.nav button:hover{background:#f1f7ff;color:var(--brand)}.nav button.active{background:#eaf3ff;color:var(--brand);box-shadow:inset 3px 0 0 var(--brand)}.nav .ico{width:21px;text-align:center}.sideFoot{margin-top:auto}.back{width:100%;border:1px solid var(--line);background:#fff;border-radius:12px;padding:11px 12px;font-weight:800;color:#37536f;cursor:pointer}.main{min-width:0}.top{height:76px;background:rgba(255,255,255,.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 26px;position:sticky;top:0;z-index:20}.top h1{font-size:17px;margin:0}.top small{display:block;color:var(--muted);margin-top:3px}.topActions{display:flex;align-items:center;gap:9px}.chip,.btn{border:1px solid var(--line);background:#fff;border-radius:11px;padding:9px 12px;font-weight:800;color:#31516f;cursor:pointer}.btn.primary{background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff;border-color:transparent;box-shadow:0 9px 22px rgba(17,102,217,.18)}.btn.good{background:#eafaf4;color:#078b5b;border-color:#beeada}.btn.bad{background:#fff1f3;color:#c7354a;border-color:#f5c7cf}.btn.warn{background:#fff7ec;color:#bb6c15;border-color:#f3d7ad}.content{padding:24px}.view{display:none}.view.active{display:block}.pageHead{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:18px}.pageHead h2{font-size:24px;margin:0}.pageHead p{margin:5px 0 0;color:var(--muted);font-size:12px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:var(--shadow);display:flex;gap:12px;align-items:center}.kpiI{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:#eaf3ff;font-size:20px}.kpi.good .kpiI{background:#e8fbf2}.kpi.warn .kpiI{background:#fff3e6}.kpi.purple .kpiI{background:#f1ecff}.kpi small{color:var(--muted);display:block}.kpi b{font-size:21px;display:block;margin-top:2px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:17px;box-shadow:var(--shadow)}.panelHead{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px}.panelHead h3{margin:0;font-size:14px}.panelBody{padding:16px}.dashboardGrid{display:grid;grid-template-columns:1.35fr .65fr;gap:15px;margin-top:15px}.quickGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.quick{padding:15px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(145deg,#fff,#f7fbff);cursor:pointer;text-align:left}.quick strong{display:block;margin-top:8px}.quick small{color:var(--muted)}.barRow{display:grid;grid-template-columns:130px 1fr 66px;gap:9px;align-items:center;margin:10px 0;font-size:12px}.bar{height:9px;background:#edf3f9;border-radius:999px;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,#1b75e8,#35b7ec);border-radius:inherit}.tableWrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:12px}th{text-align:left;color:#7087a2;font-weight:800;padding:10px;border-bottom:1px solid var(--line);white-space:nowrap}td{padding:11px 10px;border-bottom:1px solid #edf2f8;vertical-align:middle}.status{display:inline-flex;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:850;background:#eef4fb;color:#55708e}.status.good{background:#e8faf2;color:#0a8c5b}.status.bad{background:#fff0f2;color:#c4384d}.status.warn{background:#fff5e8;color:#b56b17}.saleLayout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(330px,.6fr);gap:16px}.saleSearch{display:grid;grid-template-columns:1fr auto;gap:8px}.input,select,textarea{width:100%;border:1px solid #d7e4f1;background:#fff;color:var(--text);border-radius:11px;padding:10px 11px;outline:none}.input:focus,select:focus,textarea:focus{border-color:#78aeea;box-shadow:0 0 0 3px rgba(17,102,217,.08)}.productGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:13px}.product{border:1px solid var(--line);border-radius:14px;background:#fff;overflow:hidden;cursor:pointer;transition:.15s}.product:hover{transform:translateY(-2px);box-shadow:0 12px 25px rgba(28,64,108,.09);border-color:#b9d4ef}.productImg{height:122px;background:#f4f8fc;display:grid;place-items:center;overflow:hidden}.productImg img{width:100%;height:100%;object-fit:cover}.productImg span{font-size:30px}.productInfo{padding:10px}.productInfo b{display:block;font-size:12px}.productInfo small{display:block;color:var(--muted);margin-top:3px}.productMeta{display:flex;justify-content:space-between;align-items:center;margin-top:8px}.price{font-weight:900;color:#07945f}.stock{font-size:10px;color:#66819d}.cart{position:sticky;top:92px}.cartList{display:grid;gap:8px;max-height:420px;overflow:auto}.cartItem{display:grid;grid-template-columns:1fr auto;gap:9px;padding:10px;border:1px solid var(--line);border-radius:12px;background:#fbfdff}.cartItem b{font-size:12px}.cartItem small{display:block;color:var(--muted);margin-top:3px}.qty{display:flex;align-items:center;gap:5px}.qty button{width:25px;height:25px;border:1px solid var(--line);border-radius:8px;background:#fff;cursor:pointer;font-weight:900}.totals{margin-top:13px;border-top:1px dashed #cfddeb;padding-top:11px}.totalLine{display:flex;justify-content:space-between;margin:7px 0;font-size:12px}.totalLine.grand{font-size:18px;font-weight:950}.empty{padding:35px 14px;text-align:center;color:var(--muted)}.empty .big{font-size:33px;display:block;margin-bottom:7px}.filters{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;margin-bottom:13px}.stockGrid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.categoryCards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.categoryCard{border:1px solid var(--line);border-radius:13px;padding:13px}.categoryCard b{display:block;font-size:18px;margin-top:4px}.formGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#6f849d;font-weight:800;margin:0 0 6px}.full{grid-column:1/-1}.noteItem{display:grid;grid-template-columns:2fr .8fr .8fr auto;gap:8px;align-items:end;margin-bottom:8px}.settingsGrid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.callout{padding:13px;border:1px solid #cfe0f1;background:#f2f8ff;border-radius:12px;color:#486682;font-size:12px;line-height:1.5}.callout.warn{background:#fff8ee;border-color:#f0d6ad;color:#8a641e}.modalBack{position:fixed;inset:0;background:rgba(15,33,55,.45);display:none;align-items:center;justify-content:center;padding:18px;z-index:80;backdrop-filter:blur(5px)}.modalBack.show{display:flex}.modal{width:min(680px,96vw);max-height:90vh;overflow:auto;background:#fff;border-radius:18px;border:1px solid var(--line);box-shadow:0 25px 70px rgba(12,35,64,.25)}.modalHead{padding:16px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.modalHead h3{margin:0;font-size:16px}.modalBody{padding:17px}.modalFoot{padding:14px 17px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}.close{border:0;background:#f1f5fa;width:30px;height:30px;border-radius:9px;cursor:pointer}.receipt{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;border:1px dashed #b8c9d9;padding:14px;border-radius:10px;white-space:pre-wrap;background:#fbfdff}.scanFlash{position:fixed;right:18px;bottom:18px;background:#0a8c5b;color:#fff;padding:11px 14px;border-radius:12px;box-shadow:0 13px 30px rgba(10,140,91,.28);display:none;z-index:100;font-weight:800;font-size:12px}.scanFlash.show{display:block}.miniActions{display:flex;gap:6px;flex-wrap:wrap}.miniActions button{padding:6px 8px;border-radius:8px;border:1px solid var(--line);background:#fff;cursor:pointer;font-size:10px;font-weight:800}.low{color:#d34c5e;font-weight:900}.mobileTop{display:none}.badgeFiscal{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;background:#fff7e9;color:#9f6819;font-size:10px;font-weight:850;border:1px solid #f0d6ac}
@media(max-width:1100px){.grid4{grid-template-columns:repeat(2,1fr)}.productGrid{grid-template-columns:repeat(2,1fr)}.dashboardGrid,.stockGrid,.settingsGrid{grid-template-columns:1fr}.categoryCards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.app{grid-template-columns:1fr}.side{display:none}.top{padding:0 14px}.mobileTop{display:inline-flex}.content{padding:15px}.saleLayout{grid-template-columns:1fr}.cart{position:static}.grid4{grid-template-columns:1fr 1fr}.productGrid{grid-template-columns:1fr 1fr}.filters,.formGrid{grid-template-columns:1fr}.noteItem{grid-template-columns:1fr 1fr}.noteItem .wide{grid-column:1/-1}.categoryCards{grid-template-columns:1fr}.topActions .chip{display:none}}
</style>
</head>
<body>
<div class="app">
  <aside class="side">
    <div class="brand"><div class="brandMark">▣</div><div><b>CAIXA ONDIS</b><small>PDV • Fiscal • Estoque</small></div></div>
    <nav class="nav" id="nav">
      <button class="active" data-view="dashboard"><span class="ico">⌂</span>Visão geral</button>
      <button data-view="venda"><span class="ico">🛒</span>Nova venda</button>
      <button data-view="vendas"><span class="ico">🧾</span>Vendas</button>
      <button data-view="trocas"><span class="ico">↔</span>Trocas</button>
      <button data-view="estoque"><span class="ico">▦</span>Estoque</button>
      <button data-view="notas"><span class="ico">📥</span>Notas fiscais</button>
      <button data-view="config"><span class="ico">⚙</span>Configurações</button>
    </nav>
    <div class="sideFoot"><button class="back" onclick="location.href='./index.html'">← Voltar ao ONDIS</button></div>
  </aside>
  <main class="main">
    <header class="top"><div><h1 id="topTitle">Visão geral</h1><small id="storeCtx">Caixa conectado à loja</small></div><div class="topActions"><span class="badgeFiscal" id="fiscalBadge">● Fiscal em homologação</span><button class="btn mobileTop" onclick="location.href='./index.html'">← ONDIS</button><button class="btn primary" onclick="go('venda')">+ Nova venda</button></div></header>
    <div class="content">
      <section class="view active" id="view-dashboard">
        <div class="pageHead"><div><h2>Caixa ONDIS</h2><p>Vendas, estoque, trocas e cashback em uma única operação.</p></div><button class="btn" onclick="refreshAll()">↻ Atualizar</button></div>
        <div class="grid4" id="kpis"></div>
        <div class="dashboardGrid">
          <div class="panel"><div class="panelHead"><h3>Movimento de hoje</h3><button class="btn" onclick="go('vendas')">Ver vendas</button></div><div class="panelBody"><div class="tableWrap"><table><thead><tr><th>Venda</th><th>Hora</th><th>Cliente</th><th>Pagamento</th><th>Total</th><th>Status</th></tr></thead><tbody id="todaySales"></tbody></table></div></div></div>
          <div class="panel"><div class="panelHead"><h3>Ações rápidas</h3></div><div class="panelBody"><div class="quickGrid"><button class="quick" onclick="go('venda')"><span>🛒</span><strong>Passar venda</strong><small>Busca, código ou leitor</small></button><button class="quick" onclick="openNota()"><span>📥</span><strong>Entrada de nota</strong><small>Atualiza o estoque</small></button><button class="quick" onclick="go('trocas')"><span>↔</span><strong>Trocar produto</strong><small>Vinculada à venda</small></button><button class="quick" onclick="go('estoque')"><span>📊</span><strong>Analisar estoque</strong><small>Resumo por categoria</small></button></div><div class="callout warn" style="margin-top:12px">A estrutura fiscal está preparada para integração com NFC-e/SAT/MFE. A emissão oficial depende do provedor fiscal, certificado e credenciais da loja.</div></div></div>
        </div>
        <div class="panel" style="margin-top:15px"><div class="panelHead"><h3>Estoque por categoria</h3><span class="status" id="stockAlert"></span></div><div class="panelBody" id="categoryBars"></div></div>
      </section>

      <section class="view" id="view-venda">
        <div class="pageHead"><div><h2>Nova venda</h2><p>Use o leitor de código de barras ou pesquise manualmente.</p></div><span class="status good">Leitor pronto</span></div>
        <div class="saleLayout">
          <div class="panel"><div class="panelHead"><h3>Produtos</h3><span class="status" id="productCount"></span></div><div class="panelBody"><div class="saleSearch"><input class="input" id="saleSearch" placeholder="Buscar produto, referência ou escanear código..." autocomplete="off"/><button class="btn" onclick="manualCode()">⌁ Lançar código</button></div><div class="productGrid" id="productGrid"></div></div></div>
          <aside class="panel cart"><div class="panelHead"><h3>Carrinho</h3><button class="btn bad" onclick="clearCart()">Limpar</button></div><div class="panelBody"><div id="cartList" class="cartList"></div><div class="totals"><div class="totalLine"><span>Subtotal</span><b id="subtotal">R$ 0,00</b></div><div class="totalLine"><span>Itens</span><b id="itemCount">0</b></div><div class="totalLine grand"><span>Total</span><b id="grandTotal">R$ 0,00</b></div></div><button class="btn primary" style="width:100%;margin-top:10px;padding:13px" onclick="openCheckout()">Finalizar venda →</button></div></aside>
        </div>
      </section>

      <section class="view" id="view-vendas">
        <div class="pageHead"><div><h2>Vendas</h2><p>Histórico, cancelamentos e reimpressão de comprovantes.</p></div></div>
        <div class="panel"><div class="panelBody"><div class="filters"><input class="input" id="salesSearch" placeholder="Buscar venda ou cliente..." oninput="renderSales()"/><select id="salesStatus" onchange="renderSales()"><option value="">Todos os status</option><option value="concluida">Concluídas</option><option value="cancelada">Canceladas</option></select><input class="input" id="salesDate" type="date" onchange="renderSales()"/><button class="btn" onclick="clearSalesFilters()">Limpar</button></div><div class="tableWrap"><table><thead><tr><th>Venda</th><th>Data</th><th>Cliente</th><th>Itens</th><th>Pagamento</th><th>Total</th><th>Cashback</th><th>Status</th><th>Ações</th></tr></thead><tbody id="salesTable"></tbody></table></div></div></div>
      </section>

      <section class="view" id="view-trocas">
        <div class="pageHead"><div><h2>Troca de produto</h2><p>Receba a peça antiga, devolva ao estoque e lance a nova peça.</p></div><button class="btn primary" onclick="openExchange()">+ Nova troca</button></div>
        <div class="grid4" id="exchangeKpis"></div>
        <div class="panel" style="margin-top:15px"><div class="panelHead"><h3>Trocas realizadas</h3></div><div class="panelBody"><div class="tableWrap"><table><thead><tr><th>Troca</th><th>Data</th><th>Venda origem</th><th>Cliente</th><th>Produto devolvido</th><th>Novo produto</th><th>Diferença</th></tr></thead><tbody id="exchangeTable"></tbody></table></div></div></div>
      </section>

      <section class="view" id="view-estoque">
        <div class="pageHead"><div><h2>Estoque</h2><p>Posição atual e análise simplificada por categoria.</p></div><button class="btn" onclick="openAdjust()">± Ajustar estoque</button></div>
        <div class="grid4" id="stockKpis"></div>
        <div class="stockGrid" style="margin-top:15px"><div class="panel"><div class="panelHead"><h3>Análise por categoria</h3></div><div class="panelBody"><div class="categoryCards" id="categoryCards"></div></div></div><div class="panel"><div class="panelHead"><h3>Atenção de estoque</h3><span class="status warn">≤ 3 unidades</span></div><div class="panelBody"><div class="tableWrap"><table><thead><tr><th>Produto</th><th>Categoria</th><th>Estoque</th><th>Valor</th></tr></thead><tbody id="lowStockTable"></tbody></table></div></div></div></div>
        <div class="panel" style="margin-top:15px"><div class="panelHead"><h3>Todos os produtos</h3></div><div class="panelBody"><div class="filters"><input class="input" id="stockSearch" placeholder="Buscar produto..." oninput="renderStock()"/><select id="stockCategory" onchange="renderStock()"><option value="">Todas as categorias</option></select><select id="stockLevel" onchange="renderStock()"><option value="">Todos os níveis</option><option value="low">Baixo estoque</option><option value="zero">Sem estoque</option><option value="ok">Estoque normal</option></select><button class="btn" onclick="openNota()">📥 Entrada por nota</button></div><div class="tableWrap"><table><thead><tr><th>Produto</th><th>Referência</th><th>Categoria</th><th>Qtd.</th><th>Custo</th><th>Venda</th><th>Valor em estoque</th></tr></thead><tbody id="stockTable"></tbody></table></div></div></div>
      </section>

      <section class="view" id="view-notas">
        <div class="pageHead"><div><h2>Notas fiscais de entrada</h2><p>Lançamento simplificado para entrada e atualização de estoque.</p></div><button class="btn primary" onclick="openNota()">+ Lançar nota</button></div>
        <div class="panel"><div class="panelBody"><div class="tableWrap"><table><thead><tr><th>Nota</th><th>Data</th><th>Fornecedor</th><th>Itens</th><th>Valor</th><th>Status</th></tr></thead><tbody id="notesTable"></tbody></table></div></div></div>
      </section>

      <section class="view" id="view-config">
        <div class="pageHead"><div><h2>Configurações do Caixa ONDIS</h2><p>Cashback, fiscal e regras de operação.</p></div><button class="btn primary" onclick="saveConfig()">Salvar configurações</button></div>
        <div class="settingsGrid">
          <div class="panel"><div class="panelHead"><h3>Cashback</h3><span class="status good">Automático</span></div><div class="panelBody"><div class="formGrid"><div class="field"><label>Percentual de cashback</label><input class="input" id="cfgCashback" type="number" min="0" max="100" step="0.1"/></div><div class="field"><label>Validade do bônus (dias)</label><input class="input" id="cfgCashbackDays" type="number" min="1" max="365"/></div><div class="field full"><label>Mensagem impressa</label><textarea id="cfgCashbackMsg" rows="4"></textarea></div></div><div class="callout" style="margin-top:12px">Após a venda, o Caixa gera um comprovante de cashback separado do cupom, informando o bônus e a validade configurada.</div></div></div>
          <div class="panel"><div class="panelHead"><h3>Fiscal</h3><span class="badgeFiscal">Integração</span></div><div class="panelBody"><div class="formGrid"><div class="field"><label>Ambiente</label><select id="cfgFiscalEnv"><option value="homologacao">Homologação</option><option value="producao">Produção</option></select></div><div class="field"><label>Modelo</label><select id="cfgFiscalModel"><option value="nfce">NFC-e</option><option value="sat">SAT</option><option value="mfe">MFE</option></select></div><div class="field full"><label>Provedor / integrador</label><input class="input" id="cfgFiscalProvider" placeholder="Ex.: PlugNotas, Focus NFe, TecnoSpeed..."/></div><div class="field full"><label>Token / identificação</label><input class="input" id="cfgFiscalToken" placeholder="Configure somente no ambiente seguro do backend"/></div></div><div class="callout warn" style="margin-top:12px">Para produção, o token e certificado não devem ficar no navegador. A chamada fiscal precisa passar por backend/Cloud Function segura.</div></div></div>
          <div class="panel"><div class="panelHead"><h3>Operação</h3></div><div class="panelBody"><div class="formGrid"><div class="field"><label>Estoque baixo</label><input class="input" id="cfgLowStock" type="number" min="0"/></div><div class="field"><label>Permitir venda sem estoque</label><select id="cfgAllowNegative"><option value="false">Não</option><option value="true">Sim</option></select></div><div class="field full"><label>Nome no comprovante</label><input class="input" id="cfgReceiptName"/></div></div></div></div>
          <div class="panel"><div class="panelHead"><h3>Impressão</h3></div><div class="panelBody"><div class="formGrid"><div class="field"><label>Largura</label><select id="cfgPaper"><option value="80">80 mm</option><option value="58">58 mm</option></select></div><div class="field"><label>Imprimir cashback</label><select id="cfgPrintCashback"><option value="true">Sim</option><option value="false">Não</option></select></div></div><div class="callout" style="margin-top:12px">O comprovante de cashback abre logo após o comprovante da venda e pode ser enviado para a impressora configurada pelo navegador/sistema operacional.</div></div></div>
        </div>
      </section>
    </div>
  </main>
</div>
<div class="scanFlash" id="scanFlash">Produto adicionado</div>

<div class="modalBack" id="checkoutModal"><div class="modal"><div class="modalHead"><h3>Finalizar venda</h3><button class="close" onclick="closeModal('checkoutModal')">×</button></div><div class="modalBody"><div class="formGrid"><div class="field"><label>Cliente</label><input class="input" id="checkoutCustomer" placeholder="Nome do cliente (opcional)"/></div><div class="field"><label>CPF</label><input class="input" id="checkoutCpf" placeholder="CPF na nota (opcional)"/></div><div class="field"><label>Forma de pagamento</label><select id="checkoutPayment"><option>Pix</option><option>Cartão de crédito</option><option>Cartão de débito</option><option>Dinheiro</option><option>Crediário</option></select></div><div class="field"><label>Desconto (R$)</label><input class="input" id="checkoutDiscount" type="number" min="0" step="0.01" value="0" oninput="updateCheckoutSummary()"/></div></div><div class="panel" style="box-shadow:none;margin-top:14px"><div class="panelBody" id="checkoutSummary"></div></div><div class="callout warn" style="margin-top:12px">Emissão fiscal oficial: o módulo registra a venda e prepara os dados. Para autorizar NFC-e/SAT/MFE em produção, conecte o provedor fiscal nas configurações e use backend seguro.</div></div><div class="modalFoot"><button class="btn" onclick="closeModal('checkoutModal')">Voltar</button><button class="btn primary" id="finishSaleBtn" onclick="finishSale()">Concluir venda</button></div></div></div>

<div class="modalBack" id="receiptModal"><div class="modal"><div class="modalHead"><h3>Venda concluída</h3><button class="close" onclick="closeModal('receiptModal')">×</button></div><div class="modalBody"><div class="receipt" id="receiptPreview"></div><div class="callout" id="cashbackBox" style="margin-top:12px"></div></div><div class="modalFoot"><button class="btn" onclick="printLastSale(false)">🖨 Imprimir venda</button><button class="btn good" onclick="printLastSale(true)">🎁 Imprimir cashback</button><button class="btn primary" onclick="newSale()">Nova venda</button></div></div></div>

<div class="modalBack" id="noteModal"><div class="modal"><div class="modalHead"><h3>Lançar nota fiscal de entrada</h3><button class="close" onclick="closeModal('noteModal')">×</button></div><div class="modalBody"><div class="formGrid"><div class="field"><label>Número da nota</label><input class="input" id="noteNumber" placeholder="Ex.: 000123"/></div><div class="field"><label>Fornecedor</label><input class="input" id="noteSupplier" placeholder="Razão social / fornecedor"/></div><div class="field"><label>Data de emissão</label><input class="input" type="date" id="noteDate"/></div><div class="field"><label>Chave de acesso</label><input class="input" id="noteKey" placeholder="44 dígitos (opcional)"/></div></div><div style="margin-top:14px"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><b style="font-size:12px">Itens da nota</b><button class="btn" onclick="addNoteRow()">+ Item</button></div><div id="noteItems"></div></div></div><div class="modalFoot"><button class="btn" onclick="closeModal('noteModal')">Cancelar</button><button class="btn primary" onclick="saveNote()">Dar entrada no estoque</button></div></div></div>

<div class="modalBack" id="exchangeModal"><div class="modal"><div class="modalHead"><h3>Nova troca</h3><button class="close" onclick="closeModal('exchangeModal')">×</button></div><div class="modalBody"><div class="formGrid"><div class="field full"><label>Venda de origem</label><select id="exchangeSale" onchange="loadExchangeSale()"></select></div><div class="field"><label>Produto devolvido</label><select id="exchangeOld"></select></div><div class="field"><label>Novo produto</label><select id="exchangeNew"></select></div><div class="field"><label>Quantidade</label><input class="input" type="number" id="exchangeQty" min="1" value="1"/></div><div class="field"><label>Motivo</label><select id="exchangeReason"><option>Não gostou / preferência</option><option>Tamanho</option><option>Defeito</option><option>Presente</option><option>Outro</option></select></div></div><div class="callout" style="margin-top:12px">O item devolvido volta ao estoque e o novo item é baixado automaticamente. Se houver diferença de valor, ela fica registrada na troca.</div></div><div class="modalFoot"><button class="btn" onclick="closeModal('exchangeModal')">Cancelar</button><button class="btn primary" onclick="saveExchange()">Confirmar troca</button></div></div></div>

<div class="modalBack" id="adjustModal"><div class="modal"><div class="modalHead"><h3>Ajuste manual de estoque</h3><button class="close" onclick="closeModal('adjustModal')">×</button></div><div class="modalBody"><div class="formGrid"><div class="field full"><label>Produto</label><select id="adjustProduct"></select></div><div class="field"><label>Tipo</label><select id="adjustType"><option value="in">Entrada</option><option value="out">Saída</option><option value="set">Definir saldo</option></select></div><div class="field"><label>Quantidade</label><input class="input" id="adjustQty" type="number" min="0" value="1"/></div><div class="field full"><label>Motivo</label><input class="input" id="adjustReason" placeholder="Ex.: inventário, avaria, correção..."/></div></div></div><div class="modalFoot"><button class="btn" onclick="closeModal('adjustModal')">Cancelar</button><button class="btn primary" onclick="saveAdjust()">Salvar ajuste</button></div></div></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js";
import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-auth.js";
import { getFirestore, doc, getDoc, setDoc, updateDoc, collection, onSnapshot, getDocs, query, orderBy } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-firestore.js";
const firebaseConfig={apiKey:"AIzaSyCTjYwOpMpwhGbrsUFPOgO2V-GXAwfcubA",authDomain:"omnia-3b32b.firebaseapp.com",projectId:"omnia-3b32b",storageBucket:"omnia-3b32b.firebasestorage.app",messagingSenderId:"858764463578",appId:"1:858764463578:web:1fabf841013e2053bd44e3"};
const fb=initializeApp(firebaseConfig),auth=getAuth(fb),db=getFirestore(fb);
let MY=null,STORE_ID=null,STORE_NAME="Loja",PRODUCTS=[],STOCK={},SALES=[],NOTES=[],EXCHANGES=[],CART={},LAST_SALE=null;
let CFG={cashbackPercent:5,cashbackDays:45,cashbackMsg:"Você ganhou {valor} de bônus ONDIS. Use em até {dias} dias.",lowStock:3,allowNegative:false,receiptName:"ONDIS",paper:"80",printCashback:true,fiscalEnv:"homologacao",fiscalModel:"nfce",fiscalProvider:"",fiscalToken:""};
const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}),num=v=>Number(v||0),esc=s=>(s??'').toString().replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const today=()=>new Date().toISOString().slice(0,10); const uid=()=>Math.random().toString(36).slice(2,9)+Date.now().toString(36);
const productPrice=p=>num(p.promo)>0?num(p.promo):num(p.preco);
function stockOf(id){return num(STOCK[id]?.qty||0)}
function productBy(id){return PRODUCTS.find(p=>p.id===id)}
function productName(id){return productBy(id)?.nome||id}
async function safeSet(path,data){try{await setDoc(path,data,{merge:true});return true}catch(e){console.warn(e);return false}}
function localKey(n){return `ondis_caixa_${STORE_ID||'local'}_${n}`}
function localLoad(n,fallback){try{return JSON.parse(localStorage.getItem(localKey(n)))??fallback}catch{return fallback}}
function localSave(n,v){try{localStorage.setItem(localKey(n),JSON.stringify(v))}catch{}}

onAuthStateChanged(auth,async user=>{if(!user){location.href='./login.html';return}let prof={role:'seller',name:user.email,email:user.email};try{const s=await getDoc(doc(db,'users',user.uid));if(s.exists())prof={...prof,...s.data()}}catch{}MY={uid:user.uid,...prof};STORE_ID=sessionStorage.getItem('omnia_loja_ativa')||prof.storeId||(Array.isArray(prof.storeIds)&&prof.storeIds[0])||null;if(!STORE_ID){alert('Nenhuma loja ativa. Volte ao ONDIS e selecione uma loja.');location.href='./index.html';return}try{const s=await getDoc(doc(db,'stores',STORE_ID));if(s.exists())STORE_NAME=s.data().name||s.data().code||STORE_ID}catch{}document.getElementById('storeCtx').textContent=`Loja: ${STORE_NAME} · ${MY.name||MY.email}`;await loadConfig();listenProducts();listenData();});

async function loadConfig(){try{const s=await getDoc(doc(db,'stores',STORE_ID,'caixa','config'));if(s.exists())CFG={...CFG,...s.data()};else CFG={...CFG,...localLoad('config',{})}}catch{CFG={...CFG,...localLoad('config',{})}}fillConfig();updateFiscalBadge()}
function listenProducts(){onSnapshot(collection(db,'stores',STORE_ID,'produtos'),snap=>{PRODUCTS=[];snap.forEach(d=>PRODUCTS.push({id:d.id,...d.data()}));if(!PRODUCTS.length)PRODUCTS=demoProducts();listenStock();renderProducts();populateProductSelects();refreshAll()},()=>{PRODUCTS=demoProducts();STOCK=localLoad('stock',{});seedLocalStock();refreshAll()})}
function listenStock(){onSnapshot(collection(db,'stores',STORE_ID,'caixa_estoque'),snap=>{STOCK={};snap.forEach(d=>STOCK[d.id]={...d.data()});if(!Object.keys(STOCK).length){STOCK=localLoad('stock',{});seedLocalStock()}refreshAll()},()=>{STOCK=localLoad('stock',{});seedLocalStock();refreshAll()})}
function listenData(){const bind=(col,setter,local)=>{onSnapshot(collection(db,'stores',STORE_ID,col),snap=>{const a=[];snap.forEach(d=>a.push({id:d.id,...d.data()}));setter(a.sort((x,y)=>(y.createdAt||'').localeCompare(x.createdAt||'')));refreshAll()},()=>{setter(localLoad(local,[]));refreshAll()})};bind('caixa_vendas',v=>SALES=v,'sales');bind('caixa_notas',v=>NOTES=v,'notes');bind('caixa_trocas',v=>EXCHANGES=v,'exchanges')}
function demoProducts(){return[{id:'demo_camisa_xadrez',nome:'Camisa Xadrez',ref:'OND-XD01',barcode:'789100000001',categoria:'Camisas',preco:499.9,foto:'./assets/catalogo-demo/camisa-xadrez.svg'},{id:'demo_camiseta_branca',nome:'Camiseta Branca',ref:'OND-BR02',barcode:'789100000002',categoria:'Camisetas',preco:299.9,promo:269.9,foto:'./assets/catalogo-demo/camiseta-branca.svg'},{id:'demo_camiseta_preta',nome:'Camiseta Preta',ref:'OND-PT03',barcode:'789100000003',categoria:'Camisetas',preco:269.9,foto:'./assets/catalogo-demo/camiseta-preta.svg'},{id:'demo_polo_classic',nome:'Polo Classic',ref:'OND-PC04',barcode:'789100000004',categoria:'Polos',preco:359.9,foto:'./assets/catalogo-demo/polo-classic.svg'},{id:'demo_camiseta_verde',nome:'Camiseta Verde',ref:'OND-VD05',barcode:'789100000005',categoria:'Camisetas',preco:249.9,foto:'./assets/catalogo-demo/camiseta-verde.svg'},{id:'demo_camiseta_marinho',nome:'Camiseta Marinho',ref:'OND-MA06',barcode:'789100000006',categoria:'Camisetas',preco:289.9,promo:249.9,foto:'./assets/catalogo-demo/camiseta-marinho.svg'}]}
function seedLocalStock(){let changed=false;PRODUCTS.forEach((p,i)=>{if(STOCK[p.id]==null){STOCK[p.id]={qty:8+(i%5)*3,cost:productPrice(p)*.45};changed=true}});if(changed)localSave('stock',STOCK)}

window.go=go;function go(v){document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));document.getElementById('view-'+v)?.classList.add('active');document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===v));const names={dashboard:'Visão geral',venda:'Nova venda',vendas:'Vendas',trocas:'Trocas',estoque:'Estoque',notas:'Notas fiscais',config:'Configurações'};document.getElementById('topTitle').textContent=names[v]||'Caixa ONDIS';if(v==='venda')setTimeout(()=>document.getElementById('saleSearch')?.focus(),60);refreshAll()}
document.querySelectorAll('#nav button').forEach(b=>b.onclick=()=>go(b.dataset.view));
window.refreshAll=refreshAll;function refreshAll(){renderDashboard();renderProducts();renderCart();renderSales();renderStock();renderNotes();renderExchanges();populateProductSelects()}
function renderDashboard(){const valid=SALES.filter(s=>s.status!=='cancelada'),todaySales=valid.filter(s=>(s.createdAt||'').slice(0,10)===today()),revenue=todaySales.reduce((a,s)=>a+num(s.total),0),cash=todaySales.reduce((a,s)=>a+num(s.cashback),0),units=todaySales.reduce((a,s)=>a+(s.items||[]).reduce((q,i)=>q+num(i.qty),0),0);document.getElementById('kpis').innerHTML=kpi('🧾','Vendas hoje',todaySales.length,'concluídas')+kpi('R$','Faturamento',money(revenue),'hoje','good')+kpi('▦','Peças vendidas',units,'itens','purple')+kpi('🎁','Cashback gerado',money(cash),`${CFG.cashbackPercent}% configurado`,'warn');document.getElementById('todaySales').innerHTML=todaySales.slice(0,8).map(s=>`<tr><td><b>#${esc(s.number||s.id.slice(-6))}</b></td><td>${new Date(s.createdAt).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}</td><td>${esc(s.customer||'Consumidor')}</td><td>${esc(s.payment||'-')}</td><td><b>${money(s.total)}</b></td><td><span class="status good">Concluída</span></td></tr>`).join('')||emptyRow(6,'Nenhuma venda hoje.');renderCategoryBars()}
function kpi(icon,label,value,sub,tone=''){return `<article class="kpi ${tone}"><div class="kpiI">${icon}</div><div><small>${label}</small><b>${value}</b><small>${sub}</small></div></article>`}
function emptyRow(c,msg){return `<tr><td colspan="${c}"><div class="empty">${msg}</div></td></tr>`}
function categoryData(){const m={};PRODUCTS.forEach(p=>{const c=p.categoria||'Sem categoria';m[c]=m[c]||{qty:0,value:0,products:0};m[c].qty+=stockOf(p.id);m[c].value+=stockOf(p.id)*productPrice(p);m[c].products++});return m}
function renderCategoryBars(){const d=categoryData(),vals=Object.values(d),max=Math.max(1,...vals.map(x=>x.qty));document.getElementById('categoryBars').innerHTML=Object.entries(d).map(([c,x])=>`<div class="barRow"><b>${esc(c)}</b><div class="bar"><i style="width:${x.qty/max*100}%"></i></div><span>${x.qty} un.</span></div>`).join('')||'<div class="empty">Sem dados de estoque.</div>';const low=PRODUCTS.filter(p=>stockOf(p.id)<=CFG.lowStock).length;document.getElementById('stockAlert').textContent=low?`${low} produtos pedem atenção`:'Estoque saudável'}

const saleSearch=document.getElementById('saleSearch');saleSearch.addEventListener('input',renderProducts);saleSearch.addEventListener('keydown',e=>{if(e.key==='Enter'){const q=saleSearch.value.trim();const p=findByCode(q);if(p){e.preventDefault();addToCart(p.id);saleSearch.value='';renderProducts()}}});
function findByCode(q){q=(q||'').toLowerCase();return PRODUCTS.find(p=>(p.barcode||'').toLowerCase()===q||(p.ref||'').toLowerCase()===q||p.id.toLowerCase()===q)}
window.manualCode=function(){const code=prompt('Digite ou escaneie o código / referência do produto:');if(!code)return;const p=findByCode(code);if(!p)return alert('Produto não encontrado.');addToCart(p.id)}
function renderProducts(){const el=document.getElementById('productGrid');if(!el)return;const q=(saleSearch?.value||'').toLowerCase().trim();const list=PRODUCTS.filter(p=>!q||`${p.nome} ${p.ref||''} ${p.barcode||''} ${p.categoria||''}`.toLowerCase().includes(q));document.getElementById('productCount').textContent=`${list.length} produtos`;el.innerHTML=list.map(p=>`<article class="product" onclick="addToCart('${p.id}')"><div class="productImg">${p.foto?`<img src="${esc(p.foto)}" alt="">`:'<span>👕</span>'}</div><div class="productInfo"><b>${esc(p.nome)}</b><small>${esc(p.ref||p.barcode||'Sem referência')}</small><div class="productMeta"><span class="price">${money(productPrice(p))}</span><span class="stock ${stockOf(p.id)<=CFG.lowStock?'low':''}">${stockOf(p.id)} em estoque</span></div></div></article>`).join('')||'<div class="empty"><span class="big">⌕</span>Nenhum produto encontrado.</div>'}
window.addToCart=function(id){const p=productBy(id);if(!p)return;const current=CART[id]||0;if(!CFG.allowNegative && current+1>stockOf(id))return alert('Estoque insuficiente para este produto.');CART[id]=current+1;renderCart();flash(`${p.nome} adicionado`)}
window.changeQty=function(id,d){const q=(CART[id]||0)+d;if(q<=0)delete CART[id];else if(!CFG.allowNegative&&q>stockOf(id))return alert('Estoque insuficiente.');else CART[id]=q;renderCart()}
window.clearCart=function(){CART={};renderCart()}
function cartItems(){return Object.entries(CART).map(([id,qty])=>{const p=productBy(id);return p?{productId:id,name:p.nome,ref:p.ref||'',qty,unitPrice:productPrice(p)}:null}).filter(Boolean)}
function cartSubtotal(){return cartItems().reduce((a,i)=>a+i.qty*i.unitPrice,0)}
function renderCart(){const items=cartItems(),el=document.getElementById('cartList');if(!el)return;el.innerHTML=items.length?items.map(i=>`<div class="cartItem"><div><b>${esc(i.name)}</b><small>${i.qty} × ${money(i.unitPrice)} = ${money(i.qty*i.unitPrice)}</small></div><div class="qty"><button onclick="changeQty('${i.productId}',-1)">−</button><b>${i.qty}</b><button onclick="changeQty('${i.productId}',1)">+</button></div></div>`).join(''):'<div class="empty"><span class="big">🛒</span>Seu carrinho está vazio.</div>';document.getElementById('subtotal').textContent=money(cartSubtotal());document.getElementById('grandTotal').textContent=money(cartSubtotal());document.getElementById('itemCount').textContent=items.reduce((a,i)=>a+i.qty,0)}
function flash(t){const e=document.getElementById('scanFlash');e.textContent='✓ '+t;e.classList.add('show');setTimeout(()=>e.classList.remove('show'),1300)}

window.openCheckout=function(){if(!cartItems().length)return alert('Adicione ao menos um produto.');document.getElementById('checkoutDiscount').value=0;updateCheckoutSummary();openModal('checkoutModal')}
window.updateCheckoutSummary=updateCheckoutSummary;function updateCheckoutSummary(){const sub=cartSubtotal(),disc=Math.min(sub,num(document.getElementById('checkoutDiscount')?.value)),total=Math.max(0,sub-disc),cash=total*CFG.cashbackPercent/100;document.getElementById('checkoutSummary').innerHTML=`<div class="totalLine"><span>Subtotal</span><b>${money(sub)}</b></div><div class="totalLine"><span>Desconto</span><b>− ${money(disc)}</b></div><div class="totalLine grand"><span>Total</span><b>${money(total)}</b></div><div class="totalLine"><span>Cashback a gerar</span><b style="color:#098d5c">${money(cash)}</b></div>`}
window.finishSale=async function(){const btn=document.getElementById('finishSaleBtn');btn.disabled=true;try{const items=cartItems();if(!items.length)return;for(const i of items)if(!CFG.allowNegative&&i.qty>stockOf(i.productId))return alert(`Estoque insuficiente: ${i.name}`);const sub=cartSubtotal(),disc=Math.min(sub,num(document.getElementById('checkoutDiscount').value)),total=Math.max(0,sub-disc),cashback=total*CFG.cashbackPercent/100,createdAt=new Date().toISOString(),number=String(Date.now()).slice(-7);const sale={number,createdAt,customer:document.getElementById('checkoutCustomer').value.trim(),cpf:document.getElementById('checkoutCpf').value.trim(),payment:document.getElementById('checkoutPayment').value,discount:disc,subtotal:sub,total,cashback,cashbackDays:CFG.cashbackDays,cashbackExpiresAt:new Date(Date.now()+CFG.cashbackDays*86400000).toISOString(),items,status:'concluida',fiscalStatus:'pendente_integracao',createdBy:MY.uid,createdByName:MY.name||MY.email};const id='v_'+Date.now()+'_'+uid();sale.id=id;for(const i of items)await setStock(i.productId,stockOf(i.productId)-i.qty,'sale',id);const ok=await safeSet(doc(db,'stores',STORE_ID,'caixa_vendas',id),sale);if(!ok){SALES.unshift(sale);localSave('sales',SALES)}LAST_SALE=sale;CART={};closeModal('checkoutModal');showReceipt(sale);refreshAll()}finally{btn.disabled=false}}
async function setStock(productId,qty,type,ref){STOCK[productId]={...(STOCK[productId]||{}),qty,updatedAt:new Date().toISOString(),lastMovement:type,lastRef:ref};localSave('stock',STOCK);await safeSet(doc(db,'stores',STORE_ID,'caixa_estoque',productId),STOCK[productId])}
function showReceipt(s){document.getElementById('receiptPreview').textContent=receiptText(s);const msg=CFG.cashbackMsg.replace('{valor}',money(s.cashback)).replace('{dias}',s.cashbackDays);document.getElementById('cashbackBox').innerHTML=`<b>🎁 Cashback ONDIS: ${money(s.cashback)}</b><br>${esc(msg)}<br><small>Validade: ${new Date(s.cashbackExpiresAt).toLocaleDateString('pt-BR')}</small>`;openModal('receiptModal')}
function receiptText(s){const lines=[CFG.receiptName||STORE_NAME,STORE_NAME,'--------------------------------','VENDA #'+s.number,new Date(s.createdAt).toLocaleString('pt-BR'),'Cliente: '+(s.customer||'Consumidor'),'Pagamento: '+s.payment,'--------------------------------'];(s.items||[]).forEach(i=>lines.push(`${i.qty}x ${i.name}\n   ${money(i.unitPrice)}   ${money(i.qty*i.unitPrice)}`));lines.push('--------------------------------','Subtotal: '+money(s.subtotal),'Desconto: '+money(s.discount),'TOTAL: '+money(s.total),'--------------------------------','Fiscal: integração pendente','Documento operacional do Caixa ONDIS');return lines.join('\n')}
window.printLastSale=function(cashOnly){if(!LAST_SALE)return;const s=LAST_SALE,body=cashOnly?`<h2>🎁 CASHBACK ONDIS</h2><p>Venda #${esc(s.number)}</p><h1>${money(s.cashback)}</h1><p>${esc(CFG.cashbackMsg.replace('{valor}',money(s.cashback)).replace('{dias}',s.cashbackDays))}</p><p>Válido até ${new Date(s.cashbackExpiresAt).toLocaleDateString('pt-BR')}</p>`:`<pre>${esc(receiptText(s))}</pre>`;const w=open('','_blank','width=420,height=680');w.document.write(`<html><head><title>Impressão</title><style>body{font-family:monospace;width:${CFG.paper||80}mm;margin:10mm auto;font-size:12px}h1,h2{text-align:center}pre{white-space:pre-wrap}</style></head><body>${body}<script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close()}
window.newSale=function(){closeModal('receiptModal');go('venda');document.getElementById('checkoutCustomer').value='';document.getElementById('checkoutCpf').value=''}

function renderSales(){const el=document.getElementById('salesTable');if(!el)return;const q=(document.getElementById('salesSearch')?.value||'').toLowerCase(),st=document.getElementById('salesStatus')?.value||'',dt=document.getElementById('salesDate')?.value||'';const list=SALES.filter(s=>(!q||`${s.number} ${s.customer||''}`.toLowerCase().includes(q))&&(!st||s.status===st)&&(!dt||(s.createdAt||'').slice(0,10)===dt));el.innerHTML=list.map(s=>`<tr><td><b>#${esc(s.number||s.id.slice(-6))}</b></td><td>${new Date(s.createdAt).toLocaleString('pt-BR')}</td><td>${esc(s.customer||'Consumidor')}</td><td>${(s.items||[]).reduce((a,i)=>a+num(i.qty),0)}</td><td>${esc(s.payment||'-')}</td><td><b>${money(s.total)}</b></td><td>${money(s.cashback)}</td><td><span class="status ${s.status==='cancelada'?'bad':'good'}">${s.status==='cancelada'?'Cancelada':'Concluída'}</span></td><td><div class="miniActions"><button onclick="reprintSale('${s.id}')">Imprimir</button>${s.status!=='cancelada'?`<button onclick="cancelSale('${s.id}')">Cancelar</button>`:''}</div></td></tr>`).join('')||emptyRow(9,'Nenhuma venda encontrada.')}
window.clearSalesFilters=function(){document.getElementById('salesSearch').value='';document.getElementById('salesStatus').value='';document.getElementById('salesDate').value='';renderSales()}
window.reprintSale=function(id){const s=SALES.find(x=>x.id===id);if(!s)return;LAST_SALE=s;showReceipt(s)}
window.cancelSale=async function(id){const s=SALES.find(x=>x.id===id);if(!s||s.status==='cancelada')return;if(!confirm(`Cancelar a venda #${s.number}? Os itens voltarão ao estoque.`))return;const reason=prompt('Motivo do cancelamento:','Cancelamento solicitado')||'Cancelamento';for(const i of s.items||[])await setStock(i.productId,stockOf(i.productId)+num(i.qty),'cancel',id);const upd={status:'cancelada',cancelReason:reason,cancelledAt:new Date().toISOString(),cashback:0};try{await updateDoc(doc(db,'stores',STORE_ID,'caixa_vendas',id),upd)}catch{Object.assign(s,upd);localSave('sales',SALES)}refreshAll()}

function renderStock(){if(!document.getElementById('stockTable'))return;const q=(document.getElementById('stockSearch')?.value||'').toLowerCase(),cat=document.getElementById('stockCategory')?.value||'',lvl=document.getElementById('stockLevel')?.value||'';const list=PRODUCTS.filter(p=>(!q||`${p.nome} ${p.ref||''}`.toLowerCase().includes(q))&&(!cat||(p.categoria||'Sem categoria')===cat)&&(!lvl||(lvl==='low'&&stockOf(p.id)<=CFG.lowStock&&stockOf(p.id)>0)||(lvl==='zero'&&stockOf(p.id)<=0)||(lvl==='ok'&&stockOf(p.id)>CFG.lowStock)));document.getElementById('stockTable').innerHTML=list.map(p=>`<tr><td><b>${esc(p.nome)}</b></td><td>${esc(p.ref||'-')}</td><td>${esc(p.categoria||'Sem categoria')}</td><td class="${stockOf(p.id)<=CFG.lowStock?'low':''}">${stockOf(p.id)}</td><td>${money(STOCK[p.id]?.cost||0)}</td><td>${money(productPrice(p))}</td><td>${money(stockOf(p.id)*num(STOCK[p.id]?.cost||0))}</td></tr>`).join('')||emptyRow(7,'Nenhum produto.');const totalUnits=PRODUCTS.reduce((a,p)=>a+stockOf(p.id),0),totalCost=PRODUCTS.reduce((a,p)=>a+stockOf(p.id)*num(STOCK[p.id]?.cost||0),0),low=PRODUCTS.filter(p=>stockOf(p.id)<=CFG.lowStock).length,zero=PRODUCTS.filter(p=>stockOf(p.id)<=0).length;document.getElementById('stockKpis').innerHTML=kpi('▦','Unidades em estoque',totalUnits,'peças')+kpi('R$','Valor de custo',money(totalCost),'estimado','good')+kpi('!','Estoque baixo',low,'produtos','warn')+kpi('0','Sem estoque',zero,'produtos','purple');const cats=categoryData();document.getElementById('categoryCards').innerHTML=Object.entries(cats).map(([c,x])=>`<div class="categoryCard"><small>${esc(c)}</small><b>${x.qty} un.</b><small>${x.products} produtos · ${money(x.value)}</small></div>`).join('');const lows=PRODUCTS.filter(p=>stockOf(p.id)<=CFG.lowStock).sort((a,b)=>stockOf(a.id)-stockOf(b.id));document.getElementById('lowStockTable').innerHTML=lows.map(p=>`<tr><td><b>${esc(p.nome)}</b></td><td>${esc(p.categoria||'-')}</td><td class="low">${stockOf(p.id)}</td><td>${money(stockOf(p.id)*productPrice(p))}</td></tr>`).join('')||emptyRow(4,'Nenhum item crítico.');populateCategories()}
function populateCategories(){const sel=document.getElementById('stockCategory');if(!sel)return;const old=sel.value,cats=[...new Set(PRODUCTS.map(p=>p.categoria||'Sem categoria'))].sort();sel.innerHTML='<option value="">Todas as categorias</option>'+cats.map(c=>`<option>${esc(c)}</option>`).join('');sel.value=old}
window.openAdjust=function(){populateProductSelects();document.getElementById('adjustQty').value=1;document.getElementById('adjustReason').value='';openModal('adjustModal')}
window.saveAdjust=async function(){const id=document.getElementById('adjustProduct').value,t=document.getElementById('adjustType').value,q=num(document.getElementById('adjustQty').value),old=stockOf(id);if(!id)return;let n=t==='set'?q:t==='in'?old+q:old-q;if(!CFG.allowNegative)n=Math.max(0,n);await setStock(id,n,'adjust',document.getElementById('adjustReason').value.trim());closeModal('adjustModal');refreshAll()}

window.openNota=function(){document.getElementById('noteNumber').value='';document.getElementById('noteSupplier').value='';document.getElementById('noteDate').value=today();document.getElementById('noteKey').value='';document.getElementById('noteItems').innerHTML='';addNoteRow();openModal('noteModal')}
window.addNoteRow=function(){const r=document.createElement('div');r.className='noteItem';r.innerHTML=`<div class="field wide"><label>Produto</label><select class="noteProd">${PRODUCTS.map(p=>`<option value="${p.id}">${esc(p.nome)} · ${esc(p.ref||'')}</option>`).join('')}</select></div><div class="field"><label>Qtd.</label><input class="input noteQty" type="number" min="1" value="1"></div><div class="field"><label>Custo unit.</label><input class="input noteCost" type="number" min="0" step="0.01" value="0"></div><button class="btn bad" onclick="this.parentElement.remove()">×</button>`;document.getElementById('noteItems').appendChild(r)}
window.saveNote=async function(){const number=document.getElementById('noteNumber').value.trim();if(!number)return alert('Informe o número da nota.');const rows=[...document.querySelectorAll('#noteItems .noteItem')].map(r=>({productId:r.querySelector('.noteProd').value,qty:num(r.querySelector('.noteQty').value),cost:num(r.querySelector('.noteCost').value)})).filter(x=>x.productId&&x.qty>0);if(!rows.length)return alert('Adicione itens à nota.');const id='n_'+Date.now()+'_'+uid(),note={id,number,supplier:document.getElementById('noteSupplier').value.trim(),date:document.getElementById('noteDate').value||today(),accessKey:document.getElementById('noteKey').value.trim(),items:rows,amount:rows.reduce((a,i)=>a+i.qty*i.cost,0),status:'entrada_realizada',createdAt:new Date().toISOString(),createdBy:MY.uid};for(const i of rows){STOCK[i.productId]={...(STOCK[i.productId]||{}),cost:i.cost||STOCK[i.productId]?.cost||0};await setStock(i.productId,stockOf(i.productId)+i.qty,'invoice',id)}const ok=await safeSet(doc(db,'stores',STORE_ID,'caixa_notas',id),note);if(!ok){NOTES.unshift(note);localSave('notes',NOTES)}closeModal('noteModal');refreshAll();flash('Nota lançada e estoque atualizado')}
function renderNotes(){const el=document.getElementById('notesTable');if(!el)return;el.innerHTML=NOTES.map(n=>`<tr><td><b>${esc(n.number||n.id)}</b></td><td>${n.date?new Date(n.date+'T12:00:00').toLocaleDateString('pt-BR'):'-'}</td><td>${esc(n.supplier||'-')}</td><td>${(n.items||[]).reduce((a,i)=>a+num(i.qty),0)}</td><td>${money(n.amount)}</td><td><span class="status good">Entrada realizada</span></td></tr>`).join('')||emptyRow(6,'Nenhuma nota lançada.')}

window.openExchange=function(){const valid=SALES.filter(s=>s.status!=='cancelada');if(!valid.length)return alert('Ainda não existem vendas disponíveis para troca.');document.getElementById('exchangeSale').innerHTML=valid.map(s=>`<option value="${s.id}">#${esc(s.number)} · ${esc(s.customer||'Consumidor')} · ${money(s.total)}</option>`).join('');document.getElementById('exchangeNew').innerHTML=PRODUCTS.map(p=>`<option value="${p.id}">${esc(p.nome)} · ${money(productPrice(p))} · ${stockOf(p.id)} un.</option>`).join('');loadExchangeSale();openModal('exchangeModal')}
window.loadExchangeSale=function(){const s=SALES.find(x=>x.id===document.getElementById('exchangeSale').value);document.getElementById('exchangeOld').innerHTML=(s?.items||[]).map(i=>`<option value="${i.productId}" data-price="${i.unitPrice}">${esc(i.name)} · ${money(i.unitPrice)}</option>`).join('')}
window.saveExchange=async function(){const sale=SALES.find(x=>x.id===document.getElementById('exchangeSale').value),oldId=document.getElementById('exchangeOld').value,newId=document.getElementById('exchangeNew').value,qty=Math.max(1,num(document.getElementById('exchangeQty').value));if(!sale||!oldId||!newId)return;const oldItem=(sale.items||[]).find(i=>i.productId===oldId),np=productBy(newId);if(!np)return;if(!CFG.allowNegative&&stockOf(newId)<qty)return alert('Estoque insuficiente do novo produto.');await setStock(oldId,stockOf(oldId)+qty,'exchange_in',sale.id);await setStock(newId,stockOf(newId)-qty,'exchange_out',sale.id);const diff=(productPrice(np)-num(oldItem?.unitPrice))*qty,id='t_'+Date.now()+'_'+uid(),ex={id,number:String(Date.now()).slice(-6),createdAt:new Date().toISOString(),saleId:sale.id,saleNumber:sale.number,customer:sale.customer||'',oldProductId:oldId,oldProductName:oldItem?.name||productName(oldId),newProductId:newId,newProductName:np.nome,qty,difference:diff,reason:document.getElementById('exchangeReason').value,createdBy:MY.uid};const ok=await safeSet(doc(db,'stores',STORE_ID,'caixa_trocas',id),ex);if(!ok){EXCHANGES.unshift(ex);localSave('exchanges',EXCHANGES)}closeModal('exchangeModal');refreshAll();flash('Troca registrada')}
function renderExchanges(){const el=document.getElementById('exchangeTable');if(!el)return;el.innerHTML=EXCHANGES.map(x=>`<tr><td><b>#${esc(x.number||x.id.slice(-6))}</b></td><td>${new Date(x.createdAt).toLocaleString('pt-BR')}</td><td>#${esc(x.saleNumber||'-')}</td><td>${esc(x.customer||'Consumidor')}</td><td>${esc(x.oldProductName)}</td><td>${esc(x.newProductName)}</td><td><b>${money(x.difference)}</b></td></tr>`).join('')||emptyRow(7,'Nenhuma troca registrada.');const total=EXCHANGES.length,todayN=EXCHANGES.filter(x=>(x.createdAt||'').slice(0,10)===today()).length,positive=EXCHANGES.filter(x=>num(x.difference)>0).reduce((a,x)=>a+num(x.difference),0);document.getElementById('exchangeKpis').innerHTML=kpi('↔','Trocas',total,'total registrado')+kpi('Hoje','Trocas hoje',todayN,'movimentos','good')+kpi('R$','Diferenças a receber',money(positive),'acumulado','warn')+kpi('▦','Itens movimentados',EXCHANGES.reduce((a,x)=>a+num(x.qty),0),'peças','purple')}

function fillConfig(){document.getElementById('cfgCashback').value=CFG.cashbackPercent;document.getElementById('cfgCashbackDays').value=CFG.cashbackDays;document.getElementById('cfgCashbackMsg').value=CFG.cashbackMsg;document.getElementById('cfgLowStock').value=CFG.lowStock;document.getElementById('cfgAllowNegative').value=String(!!CFG.allowNegative);document.getElementById('cfgReceiptName').value=CFG.receiptName;document.getElementById('cfgPaper').value=CFG.paper;document.getElementById('cfgPrintCashback').value=String(!!CFG.printCashback);document.getElementById('cfgFiscalEnv').value=CFG.fiscalEnv;document.getElementById('cfgFiscalModel').value=CFG.fiscalModel;document.getElementById('cfgFiscalProvider').value=CFG.fiscalProvider||'';document.getElementById('cfgFiscalToken').value=CFG.fiscalToken||''}
window.saveConfig=async function(){CFG={...CFG,cashbackPercent:Math.max(0,num(document.getElementById('cfgCashback').value)),cashbackDays:Math.max(1,num(document.getElementById('cfgCashbackDays').value)),cashbackMsg:document.getElementById('cfgCashbackMsg').value.trim()||CFG.cashbackMsg,lowStock:Math.max(0,num(document.getElementById('cfgLowStock').value)),allowNegative:document.getElementById('cfgAllowNegative').value==='true',receiptName:document.getElementById('cfgReceiptName').value.trim()||'ONDIS',paper:document.getElementById('cfgPaper').value,printCashback:document.getElementById('cfgPrintCashback').value==='true',fiscalEnv:document.getElementById('cfgFiscalEnv').value,fiscalModel:document.getElementById('cfgFiscalModel').value,fiscalProvider:document.getElementById('cfgFiscalProvider').value.trim(),fiscalToken:document.getElementById('cfgFiscalToken').value.trim()};localSave('config',CFG);await safeSet(doc(db,'stores',STORE_ID,'caixa','config'),CFG);updateFiscalBadge();refreshAll();flash('Configurações salvas')}
function updateFiscalBadge(){const b=document.getElementById('fiscalBadge');if(!b)return;b.textContent=CFG.fiscalEnv==='producao'&&CFG.fiscalProvider?'● Fiscal configurado':'● Fiscal em homologação'}
function populateProductSelects(){const html=PRODUCTS.map(p=>`<option value="${p.id}">${esc(p.nome)} · ${esc(p.ref||'')} · ${stockOf(p.id)} un.</option>`).join('');['adjustProduct'].forEach(id=>{const e=document.getElementById(id);if(e){const v=e.value;e.innerHTML=html;e.value=v}})}
window.openModal=function(id){document.getElementById(id)?.classList.add('show')};window.closeModal=function(id){document.getElementById(id)?.classList.remove('show')};document.querySelectorAll('.modalBack').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('show')}));
</script>
</body>
</html>

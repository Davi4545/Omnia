async function lookupCheckoutCpf(){const cpf=digits(document.getElementById('checkoutCpf')?.value);CHECKOUT_CLIENT=null;CHECKOUT_CASHBACK=0;if(cpf.length!==11){document.getElementById('clientLookupStatus').className='clientNew';document.getElementById('clientLookupStatus').textContent='Digite os 11 dígitos do CPF para consultar o cliente.';updateCheckoutSummary();return}let c=CLIENTS.find(x=>digits(x.cpf||x.documento)===cpf);if(!c){try{const snap=await getDocs(collection(db,'stores',STORE_ID,'clientes'));snap.forEach(d=>{const x={id:d.id,...d.data()};if(!c&&digits(x.cpf||x.documento)===cpf)c=x})}catch{}}CHECKOUT_CLIENT=c||null;if(c){document.getElementById('checkoutCustomer').value=c.nome||'';document.getElementById('checkoutPhone').value=c.telefone||c.whatsapp||'';document.getElementById('checkoutEmail').value=c.email||'';document.getElementById('checkoutBirth').value=c.nascimento||'';document.getElementById('clientLookupStatus').className='clientFound';document.getElementById('clientLookupStatus').innerHTML=`✓ Cliente reconhecido no CRM: <b>${esc(c.nome||'Cliente')}</b>`}else{document.getElementById('clientLookupStatus').className='clientNew';document.getElementById('clientLookupStatus').innerHTML='Novo cliente: os dados desta venda serão enviados automaticamente para o CRM.'}CHECKOUT_CASHBACK=cashbackAvailable(cpf);updateCheckoutSummary()}
function cashbackAvailable(cpf){cpf=digits(cpf);if(cpf.length!==11)return 0;const sales=SALES.filter(s=>s.status!=='cancelada'&&digits(s.cpf)===cpf).slice().sort((a,b)=>(a.createdAt||'').localeCompare(b.createdAt||'')),credits=[];for(const s of sales){const when=new Date(s.createdAt||Date.now()).getTime();for(let i=credits.length-1;i>=0;i--)if(credits[i].expires<when)credits.splice(i,1);let use=num(s.cashbackUsed);for(const c of credits){if(use<=0)break;const take=Math.min(c.value,use);c.value-=take;use-=take}for(let i=credits.length-1;i>=0;i--)if(credits[i].value<=0.0001)credits.splice(i,1);const value=num(s.cashback);if(value>0)credits.push({value,expires:s.cashbackExpiresAt?new Date(s.cashbackExpiresAt).getTime():Infinity})}const now=Date.now();return Math.max(0,credits.filter(c=>c.expires>=now).reduce((a,c)=>a+c.value,0))}

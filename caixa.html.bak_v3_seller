function renderDre(){const root=document.getElementById('dreKpis');if(!root)return;if(!document.getElementById('dreMonth').value)document.getElementById('dreMonth').value=today().slice(0,7);if(!document.getElementById('dreExpDate').value)document.getElementById('dreExpDate').value=today();DRE_EXPENSES=DRE_EXPENSES.filter(e=>!e.deleted);const d=dreCalc(),quality=document.getElementById('dreDataQuality'),missingCosts=d.sales.flatMap(s=>s.items||[]).filter(i=>saleItemCost(i)<=0).length;quality.textContent=missingCosts?`${missingCosts} item(ns) sem custo`:'Custos rastreados';quality.className='status '+(missingCosts?'warn':'good');root.innerHTML=kpi('R$','Receita líquida',money(d.net),`${d.sales.length} venda(s)`,'good')+kpi('◒','Lucro operacional',money(d.profit),`${d.margin.toFixed(1).replace('.',',')}% de margem`,d.profit>=0?'good':'warn')+kpi('◎','Ponto de equilíbrio',d.breakEven==null?'Sem base':money(d.breakEven),'vendas mínimas do mês','purple')+kpi('↗','Meta de faturamento',d.targetSales==null?'Sem base':money(d.targetSales),`para ${(d.targetMargin*100).toFixed(0)}% de lucro`,'warn');
const st=document.getElementById('dreStatement');st.innerHTML=`<div class="dreLine"><span>(+) Vendas brutas</span><b>${money(d.gross)}</b></div><div class="dreLine"><span>(−) Descontos comerciais</span><b>− ${money(d.discounts)}</b></div><div class="dreLine"><span>(−) Cashback utilizado</span><b>− ${money(d.cashbackUsed)}</b></div><div class="dreLine total"><strong>(=) Receita líquida</strong><strong>${money(d.net)}</strong></div><div class="dreLine"><span>(−) CMV · custo das peças vendidas</span><b>− ${money(d.cogs)}</b></div><div class="dreLine total"><strong>(=) Lucro bruto</strong><strong>${money(d.grossProfit)}</strong></div><div class="dreLine"><span>(−) Despesas variáveis</span><b>− ${money(d.variableOps)}</b></div><div class="dreLine total"><strong>(=) Margem de contribuição</strong><strong>${money(d.contribution)}</strong></div><div class="dreLine"><span>(−) Despesas fixas</span><b>− ${money(d.fixed)}</b></div><div class="dreLine total ${d.profit>=0?'profit':'loss'}"><strong>(=) Lucro operacional estimado</strong><strong>${money(d.profit)} · ${d.margin.toFixed(1).replace('.',',')}%</strong></div>`;
const ins=[];if(d.net<=0)ins.push(`<div class="dreInsight warn"><b>Comece pela receita e pelos gastos</b><p>Não há vendas no período selecionado. Lance os custos fixos mesmo assim; quando as vendas entrarem, o ONDIS calculará automaticamente lucro e ponto de equilíbrio.</p></div>`);else{if(d.breakEven!=null){const gap=d.breakEven-d.net;ins.push(`<div class="dreInsight ${gap<=0?'good':'warn'}"><b>${gap<=0?'Ponto de equilíbrio atingido':'Quanto falta para empatar'}</b><p>${gap<=0?`A loja está ${money(Math.abs(gap))} acima do ponto de equilíbrio neste mês.`:`A loja precisa de aproximadamente ${money(gap)} adicionais em receita líquida para cobrir a estrutura atual.`}</p></div>`)}if(d.targetSales!=null){const goalGap=Math.max(0,d.targetSales-d.net);ins.unshift(`<div class="dreInsight hero"><b>Meta para ${(d.targetMargin*100).toFixed(0)}% de margem</b><p>Sua loja precisa vender aproximadamente <strong>${money(d.targetSales)}</strong> no mês para buscar uma margem operacional de ${(d.targetMargin*100).toFixed(0)}%. Nesse cenário, o lucro seria cerca de <strong>${money(d.targetProfit)}</strong>. ${goalGap>0?`Faltam ${money(goalGap)} em relação ao realizado atual.`:'A receita atual já supera essa referência.'}</p></div>`)}if(d.margin<0)ins.push(`<div class="dreInsight warn"><b>Operação no vermelho</b><p>Os custos e despesas estão acima da receita líquida. Priorize revisar margem dos produtos, despesas fixas e gastos variáveis antes de perseguir crescimento de faturamento.</p></div>`);else if(d.margin<10)ins.push(`<div class="dreInsight warn"><b>Margem apertada</b><p>A operação está positiva, mas a margem está sensível a descontos, cashback, taxas e aumento de despesas. Acompanhe a contribuição por venda.</p></div>`);else ins.push(`<div class="dreInsight good"><b>Operação rentável no período</b><p>O resultado operacional está positivo. Use a meta de margem para decidir quanto crescer sem perder eficiência.</p></div>`);if(d.cashbackGenerated>0)ins.push(`<div class="dreInsight"><b>Cashback gerado</b><p>${money(d.cashbackGenerated)} foi gerado no período. O cashback só reduz a receita quando é efetivamente utilizado em uma compra; o saldo ainda não resgatado deve ser acompanhado como compromisso comercial futuro.</p></div>`)}document.getElementById('dreInsights').innerHTML=ins.join('');
const progress=d.breakEven&&d.breakEven>0?Math.min(100,d.net/d.breakEven*100):0;document.getElementById('dreScenario').innerHTML=`<div class="dreScenario"><b>Leitura executiva do mês</b><div class="dreScenarioGrid"><div class="dreScenarioCell"><small>Receita atual</small><b>${money(d.net)}</b></div><div class="dreScenarioCell"><small>Ponto de equilíbrio</small><b>${d.breakEven==null?'—':money(d.breakEven)}</b></div><div class="dreScenarioCell"><small>Meta ${(d.targetMargin*100).toFixed(0)}%</small><b>${d.targetSales==null?'—':money(d.targetSales)}</b></div></div><div style="margin-top:12px"><small style="color:var(--muted)">Avanço até o ponto de equilíbrio</small><div class="dreProgress"><i style="width:${progress}%"></i></div><div class="dreMetricSub">${progress.toFixed(0)}% da receita necessária para cobrir a estrutura calculada.</div></div></div>`;
const list=DRE_EXPENSES.filter(e=>expenseApplies(e,d.ym));document.getElementById('dreExpenseTable').innerHTML=list.map(e=>`<tr><td><b>${esc(e.description)}</b></td><td>${esc(e.category||'Outros')}</td><td><span class="status ${e.type==='variable'?'warn':''}">${e.type==='variable'?'Variável':'Fixo'}</span></td><td>${new Date((e.date||today())+'T12:00:00').toLocaleDateString('pt-BR')}</td><td>${e.recurring?'<span class="status good">Mensal</span>':'Único'}</td><td><b>${money(e.amount)}</b></td><td><button class="btn bad" onclick="removeDreExpense('${e.id}')">Excluir</button></td></tr>`).join('')||emptyRow(7,'Nenhum gasto lançado para este mês.');}

function fillConfig(){document.getElementById('cfgCashback').value=CFG.cashbackPercent;document.getElementById('cfgCashbackDays').value=CFG.cashbackDays;document.getElementById('cfgCashbackMsg').value=CFG.cashbackMsg;document.getElementById('cfgLowStock').value=CFG.lowStock;document.getElementById('cfgAllowNegative').value=String(!!CFG.allowNegative);document.getElementById('cfgReceiptName').value=CFG.receiptName;document.getElementById('cfgPaper').value=CFG.paper;document.getElementById('cfgPrintCashback').value=String(!!CFG.printCashback);document.getElementById('cfgFiscalEnv').value=CFG.fiscalEnv;document.getElementById('cfgFiscalModel').value=CFG.fiscalModel;document.getElementById('cfgFiscalProvider').value=CFG.fiscalProvider||'';document.getElementById('cfgFiscalToken').value=CFG.fiscalToken||''}
window.saveConfig=async function(){CFG={...CFG,cashbackPercent:Math.max(0,num(document.getElementById('cfgCashback').value)),cashbackDays:Math.max(1,num(document.getElementById('cfgCashbackDays').value)),cashbackMsg:document.getElementById('cfgCashbackMsg').value.trim()||CFG.cashbackMsg,lowStock:Math.max(0,num(document.getElementById('cfgLowStock').value)),allowNegative:document.getElementById('cfgAllowNegative').value==='true',receiptName:document.getElementById('cfgReceiptName').value.trim()||'ONDIS',paper:document.getElementById('cfgPaper').value,printCashback:document.getElementById('cfgPrintCashback').value==='true',fiscalEnv:document.getElementById('cfgFiscalEnv').value,fiscalModel:document.getElementById('cfgFiscalModel').value,fiscalProvider:document.getElementById('cfgFiscalProvider').value.trim(),fiscalToken:document.getElementById('cfgFiscalToken').value.trim()};localSave('config',CFG);await safeSet(doc(db,'stores',STORE_ID,'caixa','config'),CFG);updateFiscalBadge();refreshAll();flash('Configurações salvas')}
function updateFiscalBadge(){const b=document.getElementById('fiscalBadge');if(!b)return;b.textContent=CFG.fiscalEnv==='producao'&&CFG.fiscalProvider?'● Fiscal configurado':'● Fiscal em homologação'}
function populateProductSelects(){const html=PRODUCTS.map(p=>`<option value="${p.id}">${esc(p.nome)} · ${esc(p.ref||'')} · ${stockOf(p.id)} un.</option>`).join('');['adjustProduct'].forEach(id=>{const e=document.getElementById(id);if(e){const v=e.value;e.innerHTML=html;e.value=v}})}
window.openModal=function(id){document.getElementById(id)?.classList.add('show')};window.closeModal=function(id){document.getElementById(id)?.classList.remove('show')};document.querySelectorAll('.modalBack').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('show')}));
</script>
</body>
